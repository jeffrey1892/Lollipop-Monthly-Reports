# Postgres connection string. On Supabase: Project Settings -> Database -> Connection string (use the pooler, port 6543, for Vercel).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ypo_dev

# Supabase (only used for instant Realtime updates; without these the app polls every few seconds)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (without a key the app uses simple built-in placeholder text)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Email via Resend (without a key, emails are only logged, not sent)
RESEND_API_KEY=
EMAIL_FROM="YPO Lead Session <leads@your-verified-domain.com>"

# Public URL of the app, used in the QR code and email links
APP_BASE_URL=http://localhost:3100

# Facilitators: comma-separated emails, plus the shared PIN they enter once
ADMIN_EMAILS=facilitator@example.com
ADMIN_PIN=change-me

# Long random strings
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-string
